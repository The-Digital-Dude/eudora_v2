}

model Assessment {
  id                       String    @id @default(uuid())
  assessmentTypeId         String
  subjectId                String
  levelId                  String
  termId                   String?
  weekNumber               Int?
  title                    String
  description              String?
  totalMarks               Int       @default(0)
  estimatedDurationMinutes Int       @default(0)
  status                   String    @default("draft") // draft, published, archived
  countsTowardGrade        Boolean   @default(true)
  maxAttempts              Int? // null = unlimited (matches today's real unconditional behavior)
