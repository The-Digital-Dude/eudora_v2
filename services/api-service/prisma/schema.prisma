// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String?
  /// Deprecated: superseded by UserIdentity. Retained for one release so a
  /// rollback keeps working; drop once no code reads it.
  googleId           String?   @unique
  firstName          String
  lastName           String
  avatarUrl          String?
  isActive           Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles                   UserRole[]
  identities              UserIdentity[]
  studentProfile          StudentProfile?
  guardianProfile         GuardianProfile?
  teacherProfile          TeacherProfile?
  rubricAssessments       RubricAssessment[]
  authSessions            AuthSession[]
  assignedAssignments     AssessmentAssignment[] @relation("AssignedAssignments")
  markedAttempts          AssessmentAttempt[]    @relation("MarkedAttempts")
  notifications           Notification[]
  fileUploads             FileUpload[]
  guardianThreads         MessageThread[]        @relation("GuardianThreads")
  teacherThreads          MessageThread[]        @relation("TeacherThreads")
  sentMessages            Message[]              @relation("SentMessages")
  ownedNextActions        NextAction[]           @relation("OwnedNextActions")
  hostedLiveClassSessions LiveClassSession[]     @relation("HostedLiveClassSessions")

  @@map("users")
}

enum AuthProvider {
  GOOGLE
  APPLE
}

/// A federated identity linked to a user. One row per (provider, account).
model UserIdentity {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String // Google `sub` / Apple `sub`
  email          String? // email as asserted by the provider, may differ from User.email
  emailVerified  Boolean      @default(false)
  isPrivateRelay Boolean      @default(false) // Apple "Hide My Email" relay address
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. SUPER_ADMIN, ADMIN, USER
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String // e.g. "create", "read", "update", "delete"
  subject     String // e.g. "User", "Role", "Permission"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum EducationalInstitutionStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

enum CourseTermStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum CourseClassStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

enum PlacementStatus {
  PLACED
  PENDING
  WITHDRAWN
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

enum FamilyStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlanInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Campus {
  id             String                       @id @default(uuid())
  name           String                       @unique
  status         EducationalInstitutionStatus @default(ACTIVE)
  representative String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  programs     Program[]
  subscription Subscription?

  @@map("campuses")
}

model Program {
  id          String                       @id @default(uuid())
  campusId    String
  name        String
  code        String                       @unique
  status      EducationalInstitutionStatus @default(ACTIVE)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?
  deletedById String?

  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classSections ClassSection[]

  @@map("programs")
}

model AcademicYear {
  id          String                       @id @default(uuid())
  name        String                       @unique
  startDate   DateTime
  endDate     DateTime
  status      EducationalInstitutionStatus @default(ACTIVE)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?
  deletedById String?

  classSections     ClassSection[]
  terms             Term[]
  studentPlacements StudentClassPlacement[]
  timetables        Timetable[]

  @@map("academic_years")
}

model ClassSection {
  id             String      @id @default(uuid())
  programId      String
  academicYearId String
  name           String
  code           String      @unique
  class          String?
  classroom      String?
  status         ClassStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  program                  Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear             AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  placements               StudentClassPlacement[]
  dailyAttendance          DailyAttendance[]
  teachers                 ClassTeacher[]
  assessmentAssignments    AssessmentAssignment[]
  timetables               Timetable[]
  timetableSlots           TimetableSlot[]
  gradeBookEntries         GradeBookEntry[]
  placementRecommendations PlacementRecommendation[]
  liveClassSessions        LiveClassSession[]

  @@map("class_sections")
}

model Term {
  id             String           @id @default(uuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         CourseTermStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courseClasses    CourseClass[]
  assessments      Assessment[]
  timetables       Timetable[]
  gradeBookEntries GradeBookEntry[]

  @@map("terms")
}

model CourseClass {
  id          String            @id @default(uuid())
  termId      String
  name        String
  code        String            @unique
  status      CourseClassStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  deletedById String?

  term             Term                      @relation(fields: [termId], references: [id], onDelete: Cascade)
  enrollments      StudentCourseEnrollment[]
  sessions         CourseClassSession[]
  homeworks        Homework[]
  makeupRequests   MakeupRequest[]
  timetableSlots   TimetableSlot[]
  gradeBookEntries GradeBookEntry[]

  @@map("course_classes")
}

model StudentProfile {
  id          String        @id @default(uuid())
  userId      String        @unique
  fullName    String
  birthDate   DateTime
  gender      Gender
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedById String?

  user                     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  placements               StudentClassPlacement[]
  enrollments              StudentCourseEnrollment[]
  guardians                GuardianStudentRelationship[]
  families                 FamilyStudent[]
  dailyAttendance          DailyAttendance[]
  courseAttendance         CourseClassAttendance[]
  homeworkSubmissions      HomeworkSubmission[]
  assessmentEvidences      AssessmentEvidence[]
  competencyMasteries      CompetencyMastery[]
  assessmentAssignments    AssessmentAssignment[]
  assessmentAttempts       AssessmentAttempt[]
  makeupRequests           MakeupRequest[]
  lessonAttempts           LessonAttempt[]
  streak                   StudentStreak?
  experience               StudentExperience?
  gradeBookEntries         GradeBookEntry[]
  messageThreads           MessageThread[]
  masteryStatusChanges     MasteryStatusChange[]
  learningGaps             LearningGap[]
  nextActions              NextAction[]
  placementRecommendations PlacementRecommendation[]
  moduleItemProgress       ModuleItemProgress[]
  discussionPosts          DiscussionPost[]

  @@map("student_profiles")
}

model StudentClassPlacement {
  studentProfileId String
  classSectionId   String
  academicYearId   String
  status           PlacementStatus @default(PENDING)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, classSectionId])
  @@map("student_class_placements")
}

model StudentCourseEnrollment {
  id               String           @id @default(uuid())
  studentProfileId String
  courseClassId    String
  enrollmentDate   DateTime         @default(now())
  status           EnrollmentStatus @default(ENROLLED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  courseClass    CourseClass    @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, courseClassId])
  @@map("student_course_enrollments")
}

model GuardianProfile {
  id          String         @id @default(uuid())
  userId      String         @unique
  fullName    String
  email       String?
  phone       String?
  status      GuardianStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  deletedById String?

  user     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  students GuardianStudentRelationship[]
  families FamilyGuardian[]

  @@map("guardian_profiles")
}

model GuardianStudentRelationship {
  id                         String           @id @default(uuid())
  guardianProfileId          String
  studentProfileId           String
  relationshipType           RelationshipType
  isPrimary                  Boolean          @default(false)
  hasFinancialResponsibility Boolean          @default(false)
  hasAcademicAccess          Boolean          @default(true)
  hasEmergencyContact        Boolean          @default(false)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  guardianProfile GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([guardianProfileId, studentProfileId])
  @@map("guardian_student_relationships")
}

model Family {
  id            String       @id @default(uuid())
  householdName String
  status        FamilyStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  deletedById   String?

  students  FamilyStudent[]
  guardians FamilyGuardian[]
  invoices  FamilyInvoice[]
  payments  FamilyPayment[]

  @@map("families")
}

model FamilyStudent {
  familyId         String
  studentProfileId String
  createdAt        DateTime @default(now())

  family         Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@id([familyId, studentProfileId])
  @@map("family_students")
}

model FamilyGuardian {
  familyId          String
  guardianProfileId String
  createdAt         DateTime @default(now())

  family          Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  guardianProfile GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)

  @@id([familyId, guardianProfileId])
  @@map("family_guardians")
}

// ─── Teacher ────────────────────────────────────────────────────────────────

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model TeacherProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  fullName       String
  employeeCode   String?       @unique
  phone          String?
  specialization String? // e.g. "Mathematics", "Computer Science"
  status         TeacherStatus @default(ACTIVE)
  joinDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  classAssignments ClassTeacher[]
  timetableSlots   TimetableSlot[]

  @@map("teacher_profiles")
}

model ClassTeacher {
  teacherProfileId String
  classSectionId   String
  role             String   @default("PRIMARY") // PRIMARY, ASSISTANT, SUBSTITUTE
  assignedAt       DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, classSectionId])
  @@map("class_teachers")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Plan {
  id                   String   @id @default(uuid())
  name                 String   @unique
  description          String?
  priceMonthly         Decimal  @db.Decimal(10, 2)
  priceAnnual          Decimal  @db.Decimal(10, 2)
  currency             String   @default("USD")
  stripeProductId      String?
  stripePriceIdMonthly String?
  stripePriceIdAnnual  String?
  maxStudents          Int? // null = unlimited
  maxCampuses          Int?
  maxPrograms          Int?
  features             String[] // e.g. ["analytics", "api_access"]
  isActive             Boolean  @default(true)
  isPublic             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  campusId             String             @unique
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  interval             PlanInterval       @default(MONTHLY)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  campus   Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(uuid())
  subscriptionId  String
  stripeInvoiceId String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  deletedById     String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@map("invoices")
}

model Payment {
  id                    String        @id @default(uuid())
  invoiceId             String
  stripePaymentIntentId String?       @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  paymentMethod         String? // e.g. "card", "bank_transfer"
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  deletedById           String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

/// Records every Stripe event we have already processed.
/// Stripe delivers webhooks at-least-once, so handlers must be idempotent;
/// inserting the event id under a unique constraint is the dedup mechanism.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model DailyAttendance {
  id               String           @id @default(uuid())
  studentProfileId String
  classSectionId   String
  date             DateTime         @db.Date
  status           AttendanceStatus
  remarks          String?
  recordedById     String? // User ID of teacher who recorded it
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, classSectionId, date])
  @@index([classSectionId, date])
  @@index([studentProfileId, date])
  @@map("daily_attendance")
}

model CourseClassSession {
  id            String    @id @default(uuid())
  courseClassId String
  date          DateTime  @db.Date
  startTime     DateTime?
  endTime       DateTime?
  topic         String? // e.g. "Intro to Trees"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  courseClass CourseClass             @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  attendance  CourseClassAttendance[]

  @@index([courseClassId, date])
  @@map("course_class_sessions")
}

model CourseClassAttendance {
  id               String           @id @default(uuid())
  studentProfileId String
  sessionId        String
  status           AttendanceStatus
  remarks          String?
  recordedById     String? // User ID of teacher who recorded it
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  session        CourseClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, sessionId])
  @@map("course_class_attendance")
}

// ─── Homework ───────────────────────────────────────────────────────────────

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

model Homework {
  id             String   @id @default(uuid())
  courseClassId  String
  title          String
  description    String?
  dueDate        DateTime
  maxPoints      Int
  attachmentUrls String[] @default([])
  recordedById   String? // User ID of teacher who created it
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  courseClass CourseClass          @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@map("homeworks")
}

model HomeworkSubmission {
  id               String           @id @default(uuid())
  homeworkId       String
  studentProfileId String
  submissionDate   DateTime         @default(now())
  content          String? // Submitted text or solution links
  attachmentUrls   String[]         @default([])
  status           SubmissionStatus @default(SUBMITTED)
  pointsEarned     Int?
  feedback         String?
  gradedById       String? // User ID of teacher who graded it
  gradedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  homework           Homework            @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assessmentEvidence AssessmentEvidence?

  @@unique([homeworkId, studentProfileId])
  @@map("homework_submissions")
}

// ─── Evaluation & Mastery ───────────────────────────────────────────────────

enum EvidenceSourceType {
  HOMEWORK
  QUIZ
  PROJECT
  OBSERVATION
  INTERVIEW
  AI_CONVERSATION
  CLASSROOM_ACTIVITY
}

// ─── Learning Catalog ───────────────────────────────────────────────────────

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PathUnlockMode {
  FREE_ROAM
  SEQUENTIAL
}

enum ConceptKind {
  CHAPTER
  CHECKPOINT
}

model LearningSubject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
  paths   LearningPath[]

  @@map("learning_subjects")
}

model Course {
  id                String        @id @default(uuid())
  learningSubjectId String
  title             String
  slug              String        @unique
  description       String?
  estimatedHours    Int?
  status            CatalogStatus @default(DRAFT)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  deletedById       String?

  learningSubject LearningSubject      @relation(fields: [learningSubjectId], references: [id], onDelete: Cascade)
  concepts        Concept[]
  pathCourses     LearningPathCourse[]

  @@map("courses")
}

model LearningPath {
  id                String         @id @default(uuid())
  learningSubjectId String
  title             String
  slug              String         @unique
  description       String?
  unlockMode        PathUnlockMode @default(SEQUENTIAL)
  status            CatalogStatus  @default(DRAFT)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  learningSubject LearningSubject      @relation(fields: [learningSubjectId], references: [id], onDelete: Cascade)
  pathCourses     LearningPathCourse[]

  @@map("learning_paths")
}

model LearningPathCourse {
  id         String   @id @default(uuid())
  pathId     String
  courseId   String
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@map("learning_path_courses")
}

model Concept {
  id                   String      @id @default(uuid())
  name                 String      @unique
  description          String?
  courseId             String?
  sortOrder            Int         @default(1)
  kind                 ConceptKind @default(CHAPTER)
  passThresholdPercent Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  course       Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  competencies Competency[]
  lessons      Lesson[]
  items        ModuleItem[]

  @@map("concepts")
}

// ─── Coursera-style Module Items ─────────────────────────────────────────────
// A second, coexisting content shape alongside Concept -> Lesson -> Card: a
// module (Concept) can also hold a flat, ordered sequence of ModuleItems —
// Video/Reading/Discussion/Assessment today. Deliberately no LESSON kind yet
// (folding existing Lesson/Card content in as a 5th kind is future work);
// enums are additive-safe so it can be appended later without a migration.

enum ModuleItemKind {
  VIDEO
  READING
  DISCUSSION
  ASSESSMENT
}

model ModuleItem {
  id                   String         @id @default(uuid())
  conceptId            String
  kind                 ModuleItemKind
  title                String
  sortOrder            Int            @default(1)
  status               CatalogStatus  @default(DRAFT)
  videoUrl             String?
  videoDurationSeconds Int?
  readingContent       String?
  assessmentId         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  concept    Concept              @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  assessment Assessment?          @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  progress   ModuleItemProgress[]
  discussion DiscussionThread?

  @@map("module_items")
}

model ModuleItemProgress {
  id                  String    @id @default(uuid())
  moduleItemId        String
  studentProfileId    String
  completedAt         DateTime?
  lastPositionSeconds Int?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  moduleItem     ModuleItem     @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([moduleItemId, studentProfileId])
