# Every variable here is NEXT_PUBLIC_*, which means it is inlined into the
# client bundle at BUILD time — not read at runtime. Changing any of them in a
# hosting dashboard requires a rebuild/redeploy to take effect.

# Origin of the NestJS API. There is no Next.js proxy: the browser calls this
# host directly, so it must also be listed in the API's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Canonical origin of this site — feeds metadataBase, sitemap.ts, robots.ts and
# JSON-LD. Set this in every deployed environment or the generated SEO metadata
# points at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When unset the Google sign-in button renders disabled rather than
# crashing (see providers.tsx — an empty client ID makes Google's SDK throw).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Public base URL that uploaded files are served from, e.g.
# https://<project-ref>.supabase.co/storage/v1/object/public/uploads
# Read by next.config.ts to allow next/image to load uploaded images. Must
# match S3_PUBLIC_URL on the API, which is what generates the stored URLs.
S3_PUBLIC_URL=
