// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  firstName          String
  lastName           String
  isActive           Boolean            @default(true)
  failedLoginCount   Int                @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean            @default(false)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  roles               UserRole[]
  studentProfile      StudentProfile?
  guardianProfile     GuardianProfile?
  rubricAssessments   RubricAssessment[]
  authSessions        AuthSession[]
  assignedAssignments AssessmentAssignment[] @relation("AssignedAssignments")
  markedAttempts      AssessmentAttempt[]    @relation("MarkedAttempts")

  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique       // e.g. SUPER_ADMIN, ADMIN, USER
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  action      String                   // e.g. "create", "read", "update", "delete"
  subject     String                   // e.g. "User", "Role", "Permission"
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roles       RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model UserRole {
  userId      String
  roleId      String
  assignedAt  DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime  @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum EducationalInstitutionStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

enum CourseTermStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum CourseClassStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

enum PlacementStatus {
  PLACED
  PENDING
  WITHDRAWN
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

enum FamilyStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PlanInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Campus {
  id             String                       @id @default(uuid())
  name           String                       @unique
  status         EducationalInstitutionStatus @default(ACTIVE)
  representative String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  programs       Program[]
  subscription   Subscription?

  @@map("campuses")
}

model Program {
  id             String                       @id @default(uuid())
  campusId       String
  name           String
  code           String                       @unique
  status         EducationalInstitutionStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  campus         Campus                       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classSections  ClassSection[]

  @@map("programs")
}

model AcademicYear {
  id                String                       @id @default(uuid())
  name              String                       @unique
  startDate         DateTime
  endDate           DateTime
  status            EducationalInstitutionStatus @default(ACTIVE)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  classSections     ClassSection[]
  terms             Term[]
  studentPlacements StudentClassPlacement[]

  @@map("academic_years")
}

model ClassSection {
  id             String                  @id @default(uuid())
  programId      String
  academicYearId String
  name           String
  code           String                  @unique
  class          String?
  classroom      String?
  status         ClassStatus             @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  program               Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear          AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  placements            StudentClassPlacement[]
  dailyAttendance       DailyAttendance[]
  assessmentAssignments AssessmentAssignment[]

  @@map("class_sections")
}

model Term {
  id             String           @id @default(uuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         CourseTermStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courseClasses  CourseClass[]
  assessments    Assessment[]

  @@map("terms")
}

model CourseClass {
  id          String                    @id @default(uuid())
  termId      String
  name        String
  code        String                    @unique
  status      CourseClassStatus         @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  term        Term                      @relation(fields: [termId], references: [id], onDelete: Cascade)
  enrollments StudentCourseEnrollment[]
  sessions    CourseClassSession[]
  homeworks   Homework[]
  makeupRequests MakeupRequest[]

  @@map("course_classes")
}

model StudentProfile {
  id          String                        @id @default(uuid())
  userId      String                        @unique
  fullName    String
  birthDate   DateTime
  gender      Gender
  status      StudentStatus                 @default(ACTIVE)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  placements            StudentClassPlacement[]
  enrollments           StudentCourseEnrollment[]
  guardians             GuardianStudentRelationship[]
  families              FamilyStudent[]
  dailyAttendance       DailyAttendance[]
  courseAttendance      CourseClassAttendance[]
  homeworkSubmissions   HomeworkSubmission[]
  assessmentEvidences   AssessmentEvidence[]
  competencyMasteries   CompetencyMastery[]
  assessmentAssignments AssessmentAssignment[]
  assessmentAttempts    AssessmentAttempt[]
  makeupRequests        MakeupRequest[]

  @@map("student_profiles")
}

model StudentClassPlacement {
  studentProfileId String
  classSectionId   String
  academicYearId   String
  status           PlacementStatus @default(PENDING)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile   StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classSection     ClassSection    @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, classSectionId])
  @@map("student_class_placements")
}

model StudentCourseEnrollment {
  id               String           @id @default(uuid())
  studentProfileId String
  courseClassId    String
  enrollmentDate   DateTime         @default(now())
  status           EnrollmentStatus @default(ENROLLED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  courseClass      CourseClass      @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, courseClassId])
  @@map("student_course_enrollments")
}

model GuardianProfile {
  id        String                        @id @default(uuid())
  userId    String                        @unique
  fullName  String
  email     String?
  phone     String?
  status    GuardianStatus                @default(ACTIVE)
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  user      User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  students  GuardianStudentRelationship[]
  families  FamilyGuardian[]

  @@map("guardian_profiles")
}

model GuardianStudentRelationship {
  id                         String           @id @default(uuid())
  guardianProfileId          String
  studentProfileId           String
  relationshipType           RelationshipType
  isPrimary                  Boolean          @default(false)
  hasFinancialResponsibility Boolean          @default(false)
  hasAcademicAccess          Boolean          @default(true)
  hasEmergencyContact        Boolean          @default(false)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  guardianProfile            GuardianProfile  @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)
  studentProfile             StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([guardianProfileId, studentProfileId])
  @@map("guardian_student_relationships")
}

model Family {
  id            String          @id @default(uuid())
  householdName String
  status        FamilyStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  students      FamilyStudent[]
  guardians     FamilyGuardian[]

  @@map("families")
}

model FamilyStudent {
  familyId         String
  studentProfileId String
  createdAt        DateTime       @default(now())

  family           Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@id([familyId, studentProfileId])
  @@map("family_students")
}

model FamilyGuardian {
  familyId          String
  guardianProfileId String
  createdAt         DateTime        @default(now())

  family            Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  guardianProfile   GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)

  @@id([familyId, guardianProfileId])
  @@map("family_guardians")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Plan {
  id                    String         @id @default(uuid())
  name                  String         @unique
  description           String?
  priceMonthly          Decimal        @db.Decimal(10, 2)
  priceAnnual           Decimal        @db.Decimal(10, 2)
  currency              String         @default("USD")
  stripePriceIdMonthly  String?
  stripePriceIdAnnual   String?
  maxStudents           Int?           // null = unlimited
  maxCampuses           Int?
  maxPrograms           Int?
  features              String[]       // e.g. ["analytics", "api_access"]
  isActive              Boolean        @default(true)
  isPublic              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  subscriptions         Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  campusId               String             @unique
  planId                 String
  stripeCustomerId       String?
  stripeSubscriptionId   String?            @unique
  status                 SubscriptionStatus @default(TRIALING)
  interval               PlanInterval       @default(MONTHLY)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  campus                 Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  invoices               Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id                 String        @id @default(uuid())
  subscriptionId     String
  stripeInvoiceId    String?       @unique
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("USD")
  status             InvoiceStatus @default(DRAFT)
  dueDate            DateTime?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subscription       Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@map("invoices")
}

model Payment {
  id                     String        @id @default(uuid())
  invoiceId              String
  stripePaymentIntentId  String?       @unique
  amount                 Decimal       @db.Decimal(10, 2)
  currency               String        @default("USD")
  status                 PaymentStatus @default(PENDING)
  paymentMethod          String?       // e.g. "card", "bank_transfer"
  metadata               Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  invoice                Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model DailyAttendance {
  id               String           @id @default(uuid())
  studentProfileId String
  classSectionId   String
  date             DateTime         @db.Date
  status           AttendanceStatus
  remarks          String?
  recordedById     String?          // User ID of teacher who recorded it
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classSection     ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, classSectionId, date])
  @@map("daily_attendance")
}

model CourseClassSession {
  id            String                  @id @default(uuid())
  courseClassId String
  date          DateTime                @db.Date
  startTime     DateTime?
  endTime       DateTime?
  topic         String?                 // e.g. "Intro to Trees"
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  courseClass   CourseClass             @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  attendance    CourseClassAttendance[]

  @@map("course_class_sessions")
}

model CourseClassAttendance {
  id               String             @id @default(uuid())
  studentProfileId String
  sessionId        String
  status           AttendanceStatus
  remarks          String?
  recordedById     String?            // User ID of teacher who recorded it
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  session          CourseClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, sessionId])
  @@map("course_class_attendance")
}

// ─── Homework ───────────────────────────────────────────────────────────────

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

model Homework {
  id            String               @id @default(uuid())
  courseClassId String
  title         String
  description   String?
  dueDate       DateTime
  maxPoints     Int
  attachmentUrl String?              // Optional reference link for documents
  recordedById  String?              // User ID of teacher who created it
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  courseClass   CourseClass          @relation(fields: [courseClassId], references: [id], onDelete: Cascade)
  submissions   HomeworkSubmission[]

  @@map("homeworks")
}

model HomeworkSubmission {
  id               String           @id @default(uuid())
  homeworkId       String
  studentProfileId String
  submissionDate   DateTime         @default(now())
  content          String?          // Submitted text or solution links
  status           SubmissionStatus @default(SUBMITTED)
  pointsEarned     Int?
  feedback         String?
  gradedById       String?          // User ID of teacher who graded it
  gradedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  homework         Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assessmentEvidence AssessmentEvidence?

  @@unique([homeworkId, studentProfileId])
  @@map("homework_submissions")
}

// ─── Evaluation & Mastery ───────────────────────────────────────────────────

enum EvidenceSourceType {
  HOMEWORK
  QUIZ
  PROJECT
  OBSERVATION
  INTERVIEW
  AI_CONVERSATION
  CLASSROOM_ACTIVITY
}

model Concept {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  competencies Competency[]

  @@map("concepts")
}

model Competency {
  id          String               @id @default(uuid())
  conceptId   String
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  concept     Concept              @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  rubrics     Rubric[]
  evidences   AssessmentEvidence[]
  masteries   CompetencyMastery[]

  @@map("competencies")
}

model Rubric {
  id           String             @id @default(uuid())
  competencyId String
  name         String
  description  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  competency   Competency         @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  criteria     RubricCriterion[]
  assessments  RubricAssessment[]

  @@map("rubrics")
}

model RubricCriterion {
  id          String                  @id @default(uuid())
  rubricId    String
  title       String
  description String?
  weight      Float                   @default(1.0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  rubric      Rubric                  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels      RubricLevel[]
  ratings     RubricCriterionRating[]

  @@map("rubric_criteria")
}

model RubricLevel {
  id          String          @id @default(uuid())
  criterionId String
  level       Int             // 0, 1, 2, 3, 4
  title       String          // e.g. "Proficient"
  description String          // e.g. "Can compare independently"
  score       Float           // e.g. 3.0
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, level])
  @@map("rubric_levels")
}

model AssessmentEvidence {
  id                   String             @id @default(uuid())
  studentProfileId     String
  competencyId         String
  homeworkSubmissionId String?            @unique
  sourceType           EvidenceSourceType
  submittedAt          DateTime           @default(now())
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  studentProfile       StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competency           Competency         @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  homeworkSubmission   HomeworkSubmission? @relation(fields: [homeworkSubmissionId], references: [id], onDelete: SetNull)
  assessments          RubricAssessment[]

  @@map("assessment_evidences")
}

model RubricAssessment {
  id           String                  @id @default(uuid())
  rubricId     String
  evidenceId   String
  evaluatorId  String                  // User ID of evaluator
  overallScore Float?
  feedback     String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  rubric       Rubric                  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  evidence     AssessmentEvidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evaluator    User                    @relation(fields: [evaluatorId], references: [id])
  ratings      RubricCriterionRating[]

  @@map("rubric_assessments")
}

model RubricCriterionRating {
  id            String           @id @default(uuid())
  assessmentId  String
  criterionId   String
  selectedLevel Int
  comments      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assessment    RubricAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion     RubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, criterionId])
  @@map("rubric_criterion_ratings")
}

model CompetencyMastery {
  studentProfileId String
  competencyId     String
  masteryScore     Float
  confidence       Float
  updatedAt        DateTime       @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competency       Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, competencyId])
  @@map("competency_masteries")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  event       String
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model Subject {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  status      String       @default("active") // active, inactive
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assessments Assessment[]
  questions   Question[]

  @@map("subjects")
}

model Level {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  sortOrder   Int          @default(0)
  status      String       @default("active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assessments Assessment[]
  questions   Question[]

  @@map("levels")
}

model AssessmentType {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  status      String       @default("active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assessments Assessment[]

  @@map("assessment_types")
}

model Assessment {
  id                       String                 @id @default(uuid())
  assessmentTypeId         String
  subjectId                String
  levelId                  String
  termId                   String?
  weekNumber               Int?
  title                    String
  totalMarks               Int                    @default(0)
  estimatedDurationMinutes Int                    @default(0)
  status                   String                 @default("draft") // draft, published, archived
  publishedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  assessmentType           AssessmentType         @relation(fields: [assessmentTypeId], references: [id])
  subject                  Subject                @relation(fields: [subjectId], references: [id])
  level                    Level                  @relation(fields: [levelId], references: [id])
  term                     Term?                  @relation(fields: [termId], references: [id], onDelete: SetNull)

  sections                 AssessmentSection[]
  questions                AssessmentQuestion[]
  assignments              AssessmentAssignment[]

  @@map("assessments")
}

model AssessmentSection {
  id           String               @id @default(uuid())
  assessmentId String
  title        String
  sortOrder    Int                  @default(1)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  assessment   Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions    AssessmentQuestion[]

  @@map("assessment_sections")
}

model AssessmentQuestion {
  id             String             @id @default(uuid())
  assessmentId   String
  sectionId      String
  questionId     String
  questionNumber Int
  marksAvailable Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assessment     Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section        AssessmentSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question       Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

model Question {
  id            String               @id @default(uuid())
  subjectId     String
  levelId       String
  questionType  String               // mcq, short_answer, numeric
  prompt        String
  correctAnswer String?
  difficulty    String               @default("medium") // easy, medium, hard
  status        String               @default("active") // active, archived
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  subject       Subject              @relation(fields: [subjectId], references: [id])
  level         Level                @relation(fields: [levelId], references: [id])
  options       QuestionOption[]
  assessments   AssessmentQuestion[]
  responses     StudentResponse[]

  @@map("questions")
}

model QuestionOption {
  id           String   @id @default(uuid())
  questionId   String
  optionLabel  String   // A, B, C, D
  optionText   String
  isCorrect    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses    StudentResponse[]

  @@map("question_options")
}

model AssessmentAssignment {
  id               String             @id @default(uuid())
  assessmentId     String
  studentProfileId String
  classSectionId   String
  lessonId         String?
  assignedByUserId String
  opensAt          DateTime
  dueAt            DateTime
  status           String             @default("assigned") // assigned, cancelled
  reminderCount    Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  assessment       Assessment         @relation(fields: [assessmentId], references: [id])
  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classSection     ClassSection       @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  assignedByUser   User               @relation("AssignedAssignments", fields: [assignedByUserId], references: [id])
  attempts         AssessmentAttempt[]

  @@map("assessment_assignments")
}

model AssessmentAttempt {
  id                     String               @id @default(uuid())
  assessmentAssignmentId String
  studentProfileId       String
  attemptNumber          Int                  @default(1)
  startedAt              DateTime             @default(now())
  submittedAt            DateTime?
  timeSpentSeconds       Int                  @default(0)
  rawScore               Float?
  maxScore               Float?
  percentageScore        Float?
  resultStatus           String               @default("in_progress") // in_progress, completed, marked
  isLatest               Boolean              @default(true)
  isBest                 Boolean              @default(true)
  markedByUserId         String?
  teacherComment         String?
  parentComment          String?
  rawImportPayload       Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  assignment             AssessmentAssignment @relation(fields: [assessmentAssignmentId], references: [id], onDelete: Cascade)
  studentProfile         StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  markedByUser           User?                @relation("MarkedAttempts", fields: [markedByUserId], references: [id], onDelete: SetNull)
  responses              StudentResponse[]

  @@map("assessment_attempts")
}

model StudentResponse {
  id                  String            @id @default(uuid())
  assessmentAttemptId String
  questionId          String
  selectedOptionId    String?
  responseText        String?
  isCorrect           Boolean?
  marksAwarded        Float?
  marksAvailable      Float             @default(1)
  timeSpentSeconds    Int               @default(0)
  feedback            String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  attempt             AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  question            Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption      QuestionOption?   @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([assessmentAttemptId, questionId])
  @@map("student_responses")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  status    String   @default("New") // "New", "Diagnostic Scheduled", "Pending Enrolment", "Enrolled"
  source    String   @default("Website Form")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

model Broadcast {
  id             String   @id @default(uuid())
  type           String   // "Announcement", "SMS Alert", "Email Broadcast"
  title          String
  content        String?
  sender         String   @default("System")
  status         String   @default("SENT") // "SENT", "FAILED", "PENDING"
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("broadcasts")
}

model MakeupRequest {
  id               String   @id @default(uuid())
  studentProfileId String
  courseClassId    String
  originalDate     DateTime @db.Date
  reason           String?
  status           String   @default("Awaiting Action") // "Awaiting Action", "Scheduled", "Declined"
  scheduledDate    DateTime? @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  courseClass      CourseClass    @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  @@map("makeup_requests")
}
