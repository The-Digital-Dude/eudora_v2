# Core
NODE_ENV=development
PORT=5000                 # docker-compose overrides this to 3000 via .env.docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eudora_db
CORS_ORIGINS=http://localhost:3000
# Origin the client is served from. Checkout builds its Stripe success/cancel
# redirects on top of this; only relative paths are accepted from the request.
APP_URL=http://localhost:3000

# Mobile forced-upgrade gate — GET /client/min-version. Bump MOBILE_MIN_VERSION
# and restart to block older installed builds; both default to 1.0.0.
MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0

# Auth (JWT_SECRET must be >= 32 chars — app refuses to boot otherwise, see auth/utils/jwt-config.ts)
JWT_SECRET=replace-with-a-32char-min-random-secret-xxxxxxxx
JWT_EXPIRATION=1d
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Sign in with Apple. All five are required; leaving any unset disables Apple
# sign-in rather than failing at boot.
#   APPLE_CLIENT_ID   Services ID (NOT the app bundle ID), e.g. com.eudora.web
#   APPLE_TEAM_ID     10-character team ID from the Apple Developer account
#   APPLE_KEY_ID      key ID of the Sign in with Apple .p8 key
#   APPLE_PRIVATE_KEY the .p8 contents, base64-encoded so it fits on one line
#   APPLE_REDIRECT_URI must be HTTPS and registered on the Services ID.
#     Point it at the CLIENT origin, not the API host: Apple form_posts here
#     directly, and the state cookie is set on the client origin, so a URL on
#     the API host would arrive without it. Next rewrites /api/* through to
#     this service, so the client origin still reaches the callback.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://your-client-host/api/auth/apple/callback

# Billing (Stripe). Both are optional: with STRIPE_SECRET_KEY unset the API
# still boots, logs a warning, and every checkout/webhook route answers 503 —
# so a missing key degrades billing rather than the whole service.
#   STRIPE_SECRET_KEY      server-side key; hosted Checkout is used, so this
#                          service never sees card details and stays out of
#                          PCI scope.
#   STRIPE_WEBHOOK_SECRET  signing secret for POST /api/billing/webhooks/stripe.
#                          Signature verification runs over the raw body, which
#                          main.ts already preserves and the response-envelope
#                          filter already exempts for this exact path.
# Locally: `stripe listen --forward-to localhost:3000/api/billing/webhooks/stripe`
# prints the whsec_... to use here.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Live Classroom (Zoom Server-to-Server OAuth) — reserved for WS-E; not yet read by any service
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# ─── File storage ────────────────────────────────────────────────────────────
# LOCAL (default) writes to ./uploads on disk — fine for development, but wrong
# for any deployed environment: their filesystems are ephemeral, so uploads
# vanish on each restart and redeploy. Deployed environments set S3.
STORAGE_PROVIDER=LOCAL

# Required when STORAGE_PROVIDER=S3 — the service throws at boot if any is
# missing, rather than failing on the first upload.
#
# 'S3' is the protocol, not the vendor: Supabase Storage, Cloudflare R2,
# Backblaze B2 and AWS S3 are all reached this way, so switching provider is a
# change of these values rather than of code. Values below are for Supabase.
#
#   Supabase → Project Settings → Storage → S3 Connection
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<shown on the S3 Connection page, e.g. us-east-1>
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL objects are served from. Stored URLs are absolute, built as
# <S3_PUBLIC_URL>/<key>. For a public Supabase bucket this is:
#   https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# The client needs the same value in its own S3_PUBLIC_URL so next/image will
# load the images.
S3_PUBLIC_URL=
# Path-style addressing (host/bucket/key). Required by Supabase and most
# non-AWS implementations; set false only for AWS S3 proper.
S3_FORCE_PATH_STYLE=true
