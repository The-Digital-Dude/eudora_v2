  placementRecommendation PlacementRecommendation?

  @@map("assessment_attempts")
}

model StudentResponse {
  id                  String   @id @default(uuid())
  assessmentAttemptId String
  questionId          String
  selectedOptionId    String?
  responseText        String?
  interactionState    Json?
  isCorrect           Boolean?
  marksAwarded        Float?
  marksAvailable      Float    @default(1)
  timeSpentSeconds    Int      @default(0)
  feedback            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attempt        AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  question       Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption?   @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([assessmentAttemptId, questionId])
  @@map("student_responses")
}

model Lead {
