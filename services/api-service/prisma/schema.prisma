// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String?
  /// Deprecated: superseded by UserIdentity. Retained for one release so a
  /// rollback keeps working; drop once no code reads it.
  googleId           String?   @unique
  firstName          String
  lastName           String
  avatarUrl          String?
  isActive           Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles                   UserRole[]
  identities              UserIdentity[]
  studentProfile          StudentProfile?
  guardianProfile         GuardianProfile?
  teacherProfile          TeacherProfile?
  rubricAssessments       RubricAssessment[]
  authSessions            AuthSession[]
  assignedAssignments     AssessmentAssignment[] @relation("AssignedAssignments")
  markedAttempts          AssessmentAttempt[]    @relation("MarkedAttempts")
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  devicePairingCodes      DevicePairingCode[]
  fileUploads             FileUpload[]
  hostedLiveClassSessions BatchSession[]         @relation("HostedLiveClassSessions")
  assignedCourses         StudentCourseAssignment[] @relation("AssignedCourses")
  grantedEntitlements     Entitlement[]             @relation("GrantedEntitlements")
  orders                  Order[]                   @relation("GuardianOrders")
  teacherApplication      TeacherApplication?       @relation("TeacherApplicant")
  reviewedTeacherApplications TeacherApplication[]  @relation("TeacherApplicationReviewer")

  @@map("users")
}

enum AuthProvider {
  GOOGLE
  APPLE
}

/// A federated identity linked to a user. One row per (provider, account).
model UserIdentity {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String // Google `sub` / Apple `sub`
  email          String? // email as asserted by the provider, may differ from User.email
  emailVerified  Boolean      @default(false)
  isPrivateRelay Boolean      @default(false) // Apple "Hide My Email" relay address
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. SUPER_ADMIN, ADMIN, USER
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String // e.g. "create", "read", "update", "delete"
  subject     String // e.g. "User", "Role", "Permission"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum EducationalInstitutionStatus {
  ACTIVE
  INACTIVE
}

/// How a Program or Course is consumed. Drives both the duration semantics and
/// what a purchase grants: SELF_PACED sells an access window starting at
/// purchase (permanent once fully paid), LIVE sells a seat in a dated batch and
/// access ends with that batch.
enum DeliveryMode {
  SELF_PACED
  LIVE
  HYBRID
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

enum CourseTermStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum BatchStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

enum PlacementStatus {
  PLACED
  PENDING
  WITHDRAWN
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

enum FamilyStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// The primary sellable SKU. A Program bundles Courses (via `ProgramCourse`)
/// and carries the price, duration and marketing copy that the public catalog
/// and checkout render.
model Program {
  id String @id @default(uuid())
  /// Nullable on purpose: a Program with no Class is a standalone bundle — the
  /// K-6 micro-course packs — which sits outside the academic
  /// Class -> Program tree but reuses the same SKU machinery.
  classId String?
  name    String
  code    String @unique
  slug    String @unique

  /// Marketing surface. `shortDescription` is the SEO meta description;
  /// `description` is the long body on the public program page.
  shortDescription String?
  description      String?
  thumbnailUrl     String?
  outcomes         String[]
  /// The formal/board syllabus PDF parents look for. Course outlines are
  /// derived from the Concept tree instead of authored — this is the only
  /// hand-supplied syllabus artefact.
  syllabusFileId   String?

  deliveryMode DeliveryMode @default(SELF_PACED)
  /// Null when there is no fixed calendar length — self-paced bundles with
  /// permanent access.
  durationMonths Int?

  /// Money is always integer minor units (cents). Never `Decimal` — Stripe
  /// works in the smallest currency unit and the two round differently.
  /// Billing mode is derived, not stored: a monthly price present means
  /// installments are offered, absent means one-time only.
  priceOneTimeCents Int?
  priceMonthlyCents Int?
  installmentCount  Int?
  currency          String @default("USD")

  stripeProductId      String?
  stripePriceOneTimeId String?
  stripePriceMonthlyId String?

  status      CatalogStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedById String?

  class          Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  syllabusFile   FileUpload?     @relation("ProgramSyllabus", fields: [syllabusFileId], references: [id], onDelete: SetNull)
  classSections  ClassSection[]
  programCourses ProgramCourse[]
  entitlements   Entitlement[]
  orderItems     OrderItem[]

  @@index([classId])
  @@index([status])
  @@map("programs")
}

/// How a purchase is paid for. Derived from which price fields a SKU has set,
/// never chosen freely: a monthly price present means installments are offered.
/// SUBSCRIPTION is declared but has no handler — the K-6 tier is one-time only
/// (decision 4b). Keeping the value avoids a migration if that is revisited.
enum BillingMode {
  ONE_TIME
  INSTALLMENT
  SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAST_DUE
  CANCELLED
}

/// A checkout attempt. Keyed to the guardian who pays, while the Entitlement it
/// produces is keyed to the student who consumes — one guardian, three
/// children, one order.
model Order {
  id             String      @id @default(uuid())
  guardianUserId String
  status         OrderStatus @default(PENDING)
  /// Sum of the order's item prices in integer minor units, after any upgrade
  /// credit. There is no tax or shipping, so this is the amount charged.
  totalCents     Int
  currency       String      @default("USD")

  stripeCheckoutSessionId String? @unique
  stripeCustomerId        String?
  stripePaymentIntentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardian User        @relation("GuardianOrders", fields: [guardianUserId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  @@index([guardianUserId, status])
  @@map("orders")
}

model OrderItem {
  id               String @id @default(uuid())
  orderId          String
  /// The child this purchase is for, chosen in the cart rather than after
  /// payment — buying and then not knowing where the course went is the
  /// classic failure here.
  studentProfileId String

  /// Exactly one of programId / courseId, same rule as Entitlement.
  programId     String?
  courseId      String?
  /// LIVE purchases consume a seat in a specific batch. Wired in Phase 5.
  batchId String?

  billingMode      BillingMode
  /// What is actually charged for this line, after `creditAppliedCents`.
  priceCents       Int
  installmentCount Int?

  /// Set when upgrading from already-owned a-la-carte courses into the program
  /// that contains them, so the buyer is not charged twice for the overlap.
  creditAppliedCents      Int     @default(0)
  creditFromEntitlementId String?

  createdAt DateTime @default(now())

  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  program        Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  course         Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  entitlement    Entitlement?
  plan           InstallmentPlan?

  @@index([orderId])
  @@map("order_items")
}

/// A fixed-length installment plan, NOT an open-ended subscription: it carries
/// a `cancel_at` in Stripe so it self-terminates after the final payment, at
/// which point self-paced access becomes permanent.
model InstallmentPlan {
  id          String @id @default(uuid())
  orderItemId String @unique

  stripeSubscriptionId String @unique

  installmentCount          Int
  installmentsPaid          Int @default(0)
  amountPerInstallmentCents Int
  /// Absorbs the rounding remainder: 10000 over 3 is 3333 + 3333 + 3334.
  finalInstallmentCents     Int

  status          PlanStatus @default(ACTIVE)
  paidThroughDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("installment_plans")
}

/// Idempotency ledger. Stripe retries deliveries, and granting an entitlement
/// twice is the failure mode here that costs real money.
model StripeWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@map("stripe_webhook_events")
}

enum EntitlementSource {
  PURCHASE
  ADMIN_GRANT
  TRIAL
  PROMO
}

enum EntitlementStatus {
  ACTIVE
  /// An installment payment failed. Access is withheld but the row is kept so
  /// a successful retry restores it without re-purchasing.
  PAST_DUE
  EXPIRED
  REVOKED
}

/// The access grant. Course content is otherwise open to any authenticated
/// student, so this is what makes a purchase mean anything — every content
/// route resolves through `EntitlementService`.
///
/// Deliberately distinct from `StudentCourseAssignment` (a guardian's "work on
/// this next" planner, which grants nothing) and from `StudentCourseEnrollment`
/// (a seat in a term-bound class).
///
/// NOT registered in `SOFT_DELETE_MODELS`: revoking access is a `status`
/// transition, not a delete, so the history stays queryable for support and
/// refund disputes.
model Entitlement {
  id               String @id @default(uuid())
  studentProfileId String
  /// Exactly one of programId / courseId is set — enforced by a CHECK
  /// constraint in the migration, since Prisma cannot express it.
  programId        String?
  courseId         String?
  /// Set for LIVE purchases; the batch's end date is what `accessExpiresAt`
  /// tracks. Wired up in Phase 5.
  batchId    String?
  /// The purchase this grant came from. Null for ADMIN_GRANT / TRIAL / PROMO.
  orderItemId      String? @unique

  source EntitlementSource
  status EntitlementStatus @default(ACTIVE)

  accessStartsAt DateTime @default(now())
  /// Null = permanent. Self-paced access stays permanent once fully paid;
  /// live access expires with its batch.
  accessExpiresAt DateTime?
  /// While an installment plan is running, access is only live up to here.
  /// Null once the plan completes (or for one-time purchases).
  paidThroughDate DateTime?

  /// Who granted it, for ADMIN_GRANT. Kept so support actions are auditable.
  grantedByUserId String?
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  program        Program?       @relation(fields: [programId], references: [id], onDelete: Cascade)
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch    Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  orderItem      OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  grantedBy      User?          @relation("GrantedEntitlements", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, programId])
  @@unique([studentProfileId, courseId])
  @@index([studentProfileId, status])
  @@map("entitlements")
}

/// Courses are reusable across Programs (Class 9 and Class 10 Science both
/// teach Physics), so this is a join rather than a `programId` on Course.
/// Same shape as the existing `LearningPathCourse`.
model ProgramCourse {
  id         String   @id @default(uuid())
  programId  String
  courseId   String
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
  @@index([courseId])
  @@map("program_courses")
}

model AcademicYear {
  id          String                       @id @default(uuid())
  name        String                       @unique
  startDate   DateTime
  endDate     DateTime
  status      EducationalInstitutionStatus @default(ACTIVE)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  deletedAt   DateTime?
  deletedById String?

  classSections     ClassSection[]
  terms             Term[]
  studentPlacements StudentClassPlacement[]
  timetables        Timetable[]

  @@map("academic_years")
}

model ClassSection {
  id                String      @id @default(uuid())
  programId         String
  academicYearId    String
  name              String
  code              String      @unique
  /// DEPRECATED — superseded by `program.class` now that `Class` is the taxonomy
  /// master. Kept (not dropped) because `Program.classId` is nullable and
  /// backfilled only where every section under a program agreed on one grade;
  /// dropping this before admins have assigned a Class to every Program would
  /// lose the value with nothing to derive it from. Remove in a follow-up once
  /// `Program.classId` is fully populated. Read `program.class.name` in new code.
  class             String?
  classroom         String?
  /// Subject this section teaches. Nullable because `Program` can span multiple subjects, so the
  /// tag has to sit per-section rather than being inherited from the program, and because every
  /// section that existed before this column was added has no subject until an admin sets one.
  learningSubjectId String?
  status            ClassStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  deletedById       String?

  program                  Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear             AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  learningSubject          LearningSubject?          @relation(fields: [learningSubjectId], references: [id], onDelete: SetNull)
  placements               StudentClassPlacement[]
  dailyAttendance          DailyAttendance[]
  teachers                 ClassTeacher[]
  timetables               Timetable[]
  timetableSlots           TimetableSlot[]
  placementRecommendations PlacementRecommendation[]

  @@index([learningSubjectId])
  @@map("class_sections")
}

model Term {
  id             String           @id @default(uuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         CourseTermStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  batches    Batch[]
  assessments      Assessment[]
  timetables       Timetable[]
  gradeBookEntries GradeBookEntry[]

  @@map("terms")
}

/// A dated cohort of a Course.
///
/// Previously `CourseClass`, renamed in its own dedicated pass once the
/// commerce work had settled. The old name collided with `Class` (the grade
/// level) and `ClassSection` (the roster) — three unrelated models sharing one
/// word, which made it easy to reach for the wrong one.
model Batch {
  id String @id @default(uuid())
  /// Nullable only because every row predating the catalogue weld has no
  /// course. New batches always carry one — the API requires it. This link is
  /// what finally joins the catalogue tree to the operational one.
  courseId String?
  /// Nullable now: a rolling batch belongs to no school term.
  termId      String?
  name        String
  code        String            @unique
  status      BatchStatus @default(ACTIVE)
  description String?
  /// Null = unlimited. Guardian self-enrollment (`isOpenForEnrollment`)
  /// checks this; staff-mediated enrollment does not.
  capacity    Int?
  /// Default false is the safety valve for guardian self-enrollment: this
  /// migration makes nothing newly self-enrollable. Staff opt each class in
  /// deliberately.
  isOpenForEnrollment Boolean   @default(false)

  /// A LIVE purchase buys a seat in a dated cohort, and `endDate` is what the
  /// resulting entitlement's `accessExpiresAt` tracks — live access ends with
  /// the batch, unlike self-paced which is permanent once paid.
  startDate          DateTime?
  endDate            DateTime?
  /// After this, the batch stops accepting new seats even if capacity remains.
  enrollmentDeadline DateTime?

  leadTeacherProfileId String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  deletedById String?

  course           Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  term             Term?                     @relation(fields: [termId], references: [id], onDelete: SetNull)
  leadTeacher      TeacherProfile?           @relation("LeadBatchTeacher", fields: [leadTeacherProfileId], references: [id], onDelete: SetNull)
  enrollments      StudentCourseEnrollment[]
  entitlements     Entitlement[]
  sessions         BatchSession[]
  homeworks        Homework[]
  makeupRequests   MakeupRequest[]
  timetableSlots   TimetableSlot[]
  gradeBookEntries GradeBookEntry[]

  @@index([courseId, status])
  @@index([startDate])
  @@map("batches")
}

/// Teachers attached to a Course. This is the actual answer to "one course,
/// many teachers" — a join table, not a cohort system. `Batch` above is
/// a cohort and earns its place separately, through live delivery.
model CourseTeacher {
  courseId         String
  teacherProfileId String
  /// LEAD | ASSISTANT
  role             String   @default("LEAD")
  assignedAt       DateTime @default(now())

  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@id([courseId, teacherProfileId])
  @@index([teacherProfileId])
  @@map("course_teachers")
}

model StudentProfile {
  id                    String        @id @default(uuid())
  userId                String        @unique
  fullName              String
  birthDate             DateTime
  gender                Gender
  /// The child's grade level, captured when a guardian adds them.
  ///
  /// Deliberately a direct link rather than going through
  /// `StudentClassPlacement -> ClassSection`: that path is the operational
  /// roster and needs a Program and an AcademicYear, which a consumer signup
  /// has neither of. A guardian buying a course just needs to say "Grade 3".
  classId               String?
  status                StudentStatus @default(ACTIVE)
  // Self-service profile-completion fields (mobile/web Settings) — nullable
  // because every existing StudentProfile was created without them.
  phone                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  deletedById           String?

  user                     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  class                    Class?                        @relation(fields: [classId], references: [id], onDelete: SetNull)
  placements               StudentClassPlacement[]
  enrollments              StudentCourseEnrollment[]
  guardians                GuardianStudentRelationship[]
  families                 FamilyStudent[]
  dailyAttendance          DailyAttendance[]
  courseAttendance         BatchAttendance[]
  homeworkSubmissions      HomeworkSubmission[]
  assessmentEvidences      AssessmentEvidence[]
  competencyMasteries      CompetencyMastery[]
  assessmentAttempts       AssessmentAttempt[]
  assessmentAssignments    AssessmentAssignment[]
  gradeBookEntries         GradeBookEntry[]
  makeupRequests           MakeupRequest[]
  lessonAttempts           LessonAttempt[]
  streak                   StudentStreak?
  experience               StudentExperience?
  masteryStatusChanges     MasteryStatusChange[]
  placementRecommendations PlacementRecommendation[]
  moduleItemProgress       ModuleItemProgress[]
  discussionPosts          DiscussionPost[]
  courseAssignments        StudentCourseAssignment[]
  entitlements             Entitlement[]
  orderItems               OrderItem[]

  @@index([classId])
  @@map("student_profiles")
}

model StudentClassPlacement {
  studentProfileId String
  classSectionId   String
  academicYearId   String
  status           PlacementStatus @default(PENDING)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, classSectionId])
  @@map("student_class_placements")
}

model StudentCourseEnrollment {
  id               String           @id @default(uuid())
  studentProfileId String
  batchId    String
  enrollmentDate   DateTime         @default(now())
  status           EnrollmentStatus @default(ENROLLED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, batchId])
  @@map("student_course_enrollments")
}

model GuardianProfile {
  id          String         @id @default(uuid())
  userId      String         @unique
  fullName    String
  email       String?
  phone       String?
  status      GuardianStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  deletedById String?

  user     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  students GuardianStudentRelationship[]
  families FamilyGuardian[]

  @@map("guardian_profiles")
}

model GuardianStudentRelationship {
  id                         String           @id @default(uuid())
  guardianProfileId          String
  studentProfileId           String
  relationshipType           RelationshipType
  isPrimary                  Boolean          @default(false)
  hasFinancialResponsibility Boolean          @default(false)
  hasAcademicAccess          Boolean          @default(true)
  hasEmergencyContact        Boolean          @default(false)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  guardianProfile GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([guardianProfileId, studentProfileId])
  @@map("guardian_student_relationships")
}

model Family {
  id            String       @id @default(uuid())
  householdName String
  status        FamilyStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  deletedById   String?

  students  FamilyStudent[]
  guardians FamilyGuardian[]
  invoices  FamilyInvoice[]
  payments  FamilyPayment[]

  @@map("families")
}

model FamilyStudent {
  familyId         String
  studentProfileId String
  createdAt        DateTime @default(now())

  family         Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@id([familyId, studentProfileId])
  @@map("family_students")
}

model FamilyGuardian {
  familyId          String
  guardianProfileId String
  createdAt         DateTime @default(now())

  family          Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  guardianProfile GuardianProfile @relation(fields: [guardianProfileId], references: [id], onDelete: Cascade)

  @@id([familyId, guardianProfileId])
  @@map("family_guardians")
}

// ─── Teacher ────────────────────────────────────────────────────────────────

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model TeacherProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  fullName       String
  employeeCode   String?       @unique
  phone          String?
  specialization String? // e.g. "Mathematics", "Computer Science"
  status         TeacherStatus @default(ACTIVE)
  joinDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedById    String?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  classAssignments ClassTeacher[]
  courseTeachers   CourseTeacher[]
  leadBatches      Batch[]   @relation("LeadBatchTeacher")
  timetableSlots   TimetableSlot[]

  @@map("teacher_profiles")
}

enum TeacherApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/**
 * Someone asking to teach here. Deliberately NOT a TeacherProfile: the TEACHER
 * role reaches student names, attendance and grades, so it is granted by a
 * human reviewing this row, never by the act of submitting one. Approval is
 * what creates the profile and assigns the role.
 */
model TeacherApplication {
  id     String @id @default(uuid())
  /// One open application per account. A rejected applicant who should be
  /// reconsidered has this row reopened rather than filing a second.
  userId String @unique

  fullName        String
  phone           String?
  specialization  String?
  yearsExperience Int?
  bio             String?

  /// The CV. Stored privately and reached through a short-lived signed URL —
  /// it carries a home address and phone number, so it must never sit in the
  /// public object namespace the rest of our uploads use.
  resumeFileId String @unique

  status      TeacherApplicationStatus @default(PENDING)
  reviewNotes String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation("TeacherApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("TeacherApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resumeFile FileUpload @relation("TeacherApplicationResume", fields: [resumeFileId], references: [id])

  @@index([status, createdAt])
  @@map("teacher_applications")
}

model ClassTeacher {
  teacherProfileId String
  classSectionId   String
  role             String   @default("PRIMARY") // PRIMARY, ASSISTANT, SUBSTITUTE
  assignedAt       DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, classSectionId])
  @@map("class_teachers")
}


// ─── Attendance ──────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model DailyAttendance {
  id               String           @id @default(uuid())
  studentProfileId String
  classSectionId   String
  date             DateTime         @db.Date
  status           AttendanceStatus
  remarks          String?
  recordedById     String? // User ID of teacher who recorded it
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, classSectionId, date])
  @@index([classSectionId, date])
  @@index([studentProfileId, date])
  @@map("daily_attendance")
}

/// One scheduled meeting of one cohort.
///
/// Absorbed `LiveClassSession` on 2026-08-17. A live class is authored once as
/// a `ModuleItem(kind: LIVE_CLASS)` inside a chapter, but each batch that buys
/// the course meets at its own time on its own link — so the curriculum slot
/// lives on the item and the meeting lives here. `moduleItemId` is the link
/// back; it is null for ad-hoc sessions that are not part of the outline.
model BatchSession {
  id           String    @id @default(uuid())
  batchId      String
  moduleItemId String?
  date         DateTime  @db.Date
  startTime    DateTime?
  endTime      DateTime?
  topic        String? // e.g. "Intro to Trees"

  // Meeting fields, inherited from the old LiveClassSession. `provider` stays
  // NONE until the Zoom Server-to-Server OAuth hook is implemented.
  teacherUserId     String?
  status            LiveClassStatus   @default(SCHEDULED)
  provider          LiveClassProvider @default(NONE)
  externalMeetingId String?
  joinUrl           String?
  startUrl          String?
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch      Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  moduleItem ModuleItem?       @relation(fields: [moduleItemId], references: [id], onDelete: SetNull)
  teacher    User?             @relation("HostedLiveClassSessions", fields: [teacherUserId], references: [id], onDelete: SetNull)
  attendance BatchAttendance[]

  @@index([batchId, date])
  @@index([moduleItemId])
  @@index([teacherUserId, date])
  @@map("batch_sessions")
}

model BatchAttendance {
  id               String           @id @default(uuid())
  studentProfileId String
  sessionId        String
  status           AttendanceStatus
  remarks          String?
  recordedById     String? // User ID of teacher who recorded it
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  session        BatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, sessionId])
  @@map("batch_attendance")
}

// ─── Homework ───────────────────────────────────────────────────────────────

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

model Homework {
  id             String   @id @default(uuid())
  batchId  String
  title          String
  description    String?
  dueDate        DateTime
  maxPoints      Int
  attachmentUrls String[] @default([])
  recordedById   String? // User ID of teacher who created it
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batch Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@map("homeworks")
}

model HomeworkSubmission {
  id               String           @id @default(uuid())
  homeworkId       String
  studentProfileId String
  submissionDate   DateTime         @default(now())
  content          String? // Submitted text or solution links
  attachmentUrls   String[]         @default([])
  status           SubmissionStatus @default(SUBMITTED)
  pointsEarned     Int?
  feedback         String?
  gradedById       String? // User ID of teacher who graded it
  gradedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  homework           Homework            @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assessmentEvidence AssessmentEvidence?

  @@unique([homeworkId, studentProfileId])
  @@map("homework_submissions")
}

// ─── Evaluation & Mastery ───────────────────────────────────────────────────

enum EvidenceSourceType {
  HOMEWORK
  QUIZ
  PROJECT
  OBSERVATION
  INTERVIEW
  AI_CONVERSATION
  CLASSROOM_ACTIVITY
}

// ─── Learning Catalog ───────────────────────────────────────────────────────

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PathUnlockMode {
  FREE_ROAM
  SEQUENTIAL
}

enum ConceptKind {
  CHAPTER
  CHECKPOINT
}

/// Catalogue taxonomy: groups Course, LearningPath and ClassSection.
///
/// NOT the same concept as the `Subject` model, which tags Assessment/Question rows only. The two
/// are unrelated — no foreign key, no shared rows.
model LearningSubject {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses       Course[]
  paths         LearningPath[]
  classSections ClassSection[]

  @@map("learning_subjects")
}

/// K-6 grade-band tag on a Course. One Course already represents "one
/// subject's worth of content at one level", so Course is the natural
/// granularity for this rather than tagging Concept or LearningSubject.
///
/// Deliberately NOT superseded by the Class -> Program taxonomy: standalone
/// micro-courses (alphabet, times tables, fractions) belong to no Program and
/// therefore have no Class to derive a level from. `gradeBand` is the only
/// thing that categorises them, and it is what the public /kids browse route
/// filters on.
enum GradeBand {
  PRE_K_K
  G1_2
  G3_4
  G5_6
}

model Course {
  id                String        @id @default(uuid())
  learningSubjectId String
  title             String
  slug              String        @unique
  description       String?
  thumbnailUrl      String?
  /// Content effort ("12 hours of material"). Distinct from `durationWeeks`,
  /// which is calendar length — the two are unrelated numbers.
  estimatedHours    Int?
  durationWeeks     Int?
  status            CatalogStatus @default(DRAFT)
  sortOrder         Int           @default(0)
  gradeBand         GradeBand?
  deliveryMode      DeliveryMode  @default(SELF_PACED)

  /// Null = not sold a la carte; the Course is only reachable by buying a
  /// Program that contains it. Integer cents, never `Decimal`.
  priceOneTimeCents Int?
  priceMonthlyCents Int?
  installmentCount  Int?
  currency          String @default("USD")

  stripeProductId      String?
  stripePriceOneTimeId String?
  stripePriceMonthlyId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  learningSubject    LearningSubject           @relation(fields: [learningSubjectId], references: [id], onDelete: Cascade)
  concepts           Concept[]
  pathCourses        LearningPathCourse[]
  programCourses     ProgramCourse[]
  studentAssignments StudentCourseAssignment[]
  entitlements       Entitlement[]
  batches      Batch[]
  courseTeachers     CourseTeacher[]
  orderItems         OrderItem[]

  @@index([gradeBand])
  @@index([status])
  @@map("courses")
}

/// A guardian (or staff member) picking a catalog course for a specific
/// student — a curated "learning plan", NOT an access grant. Catalog content
/// is open to any authenticated student already (gated only by
/// `Course.status`); this only says "this is what
/// you should work on". Deliberately distinct from `StudentCourseEnrollment`,
/// which points at a term-bound `Batch` and carries real academic
/// weight (gradebook, attendance, homework) — the two models are unrelated.
model StudentCourseAssignment {
  id               String   @id @default(uuid())
  studentProfileId String
  courseId         String
  /// Who chose it — a guardian or a staff member. Kept so the student-facing
  /// UI can say who assigned it, and so staff can audit guardian actions.
  assignedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy     User           @relation("AssignedCourses", fields: [assignedByUserId], references: [id])

  @@unique([studentProfileId, courseId])
  @@map("student_course_assignments")
}

model LearningPath {
  id                String         @id @default(uuid())
  learningSubjectId String
  title             String
  slug              String         @unique
  description       String?
  unlockMode        PathUnlockMode @default(SEQUENTIAL)
  status            CatalogStatus  @default(DRAFT)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  learningSubject LearningSubject      @relation(fields: [learningSubjectId], references: [id], onDelete: Cascade)
  pathCourses     LearningPathCourse[]

  @@map("learning_paths")
}

model LearningPathCourse {
  id         String   @id @default(uuid())
  pathId     String
  courseId   String
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@map("learning_path_courses")
}

model Concept {
  id                   String      @id @default(uuid())
  name                 String      @unique
  description          String?
  courseId             String?
  sortOrder            Int         @default(1)
  kind                 ConceptKind @default(CHAPTER)
  passThresholdPercent Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  course       Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  competencies Competency[]
  lessons      Lesson[]
  items        ModuleItem[]

  @@map("concepts")
}

// ─── Coursera-style Module Items ─────────────────────────────────────────────
// A second, coexisting content shape alongside Concept -> Lesson -> Card: a
// module (Concept) can also hold a flat, ordered sequence of ModuleItems —
// Video/Reading/Discussion/Assessment today. Deliberately no LESSON kind yet
// (folding existing Lesson/Card content in as a 5th kind is future work);
// enums are additive-safe so it can be appended later without a migration.

enum ModuleItemKind {
  VIDEO
  READING
  DISCUSSION
  ASSESSMENT
  /// The curriculum *slot* for a live session, not the meeting itself. One
  /// LIVE_CLASS item resolves to a different `BatchSession` for every cohort
  /// that buys the course, so the date and join link live there, not here.
  /// A course containing one of these is LIVE-only — see `assertDeliveryMode`.
  LIVE_CLASS
}

model ModuleItem {
  id                   String         @id @default(uuid())
  conceptId            String
  kind                 ModuleItemKind
  title                String
  sortOrder            Int            @default(1)
  status               CatalogStatus  @default(DRAFT)
  videoUrl             String?
  videoDurationSeconds Int?
  readingContent       String?
  assessmentId         String?
  /// Ungated even for anonymous visitors. A public course page with nothing
  /// playable converts badly and gives search engines nothing to index, so a
  /// few items per course are deliberately given away.
  isFreePreview        Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  concept    Concept              @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  assessment Assessment?          @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  progress   ModuleItemProgress[]
  discussion DiscussionThread?
  /// Populated only for LIVE_CLASS items — one row per cohort meeting.
  sessions   BatchSession[]

  @@map("module_items")
}

model ModuleItemProgress {
  id                  String    @id @default(uuid())
  moduleItemId        String
  studentProfileId    String
  completedAt         DateTime?
  lastPositionSeconds Int?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  moduleItem     ModuleItem     @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([moduleItemId, studentProfileId])
  @@map("module_item_progress")
}

model DiscussionThread {
  id           String   @id @default(uuid())
  moduleItemId String   @unique
  prompt       String
  createdAt    DateTime @default(now())

  moduleItem ModuleItem       @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  posts      DiscussionPost[]

  @@map("discussion_threads")
}

model DiscussionPost {
  id                 String   @id @default(uuid())
  discussionThreadId String
  studentProfileId   String
  parentPostId       String?
  body               String
  createdAt          DateTime @default(now())

  thread         DiscussionThread @relation(fields: [discussionThreadId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  parentPost     DiscussionPost?  @relation("Replies", fields: [parentPostId], references: [id], onDelete: SetNull)
  replies        DiscussionPost[] @relation("Replies")

  @@map("discussion_posts")
}

model Competency {
  id          String   @id @default(uuid())
  conceptId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  concept              Concept               @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  rubrics              Rubric[]
  evidences            AssessmentEvidence[]
  masteries            CompetencyMastery[]
  masteryStatusChanges MasteryStatusChange[]

  @@map("competencies")
}

model Rubric {
  id           String   @id @default(uuid())
  competencyId String
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competency  Competency         @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  criteria    RubricCriterion[]
  assessments RubricAssessment[]

  @@map("rubrics")
}

model RubricCriterion {
  id          String   @id @default(uuid())
  rubricId    String
  title       String
  description String?
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rubric  Rubric                  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels  RubricLevel[]
  ratings RubricCriterionRating[]

  @@map("rubric_criteria")
}

model RubricLevel {
  id          String   @id @default(uuid())
  criterionId String
  level       Int // 0, 1, 2, 3, 4
  title       String // e.g. "Proficient"
  description String // e.g. "Can compare independently"
  score       Float // e.g. 3.0
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, level])
  @@map("rubric_levels")
}

model AssessmentEvidence {
  id                   String             @id @default(uuid())
  studentProfileId     String
  competencyId         String
  homeworkSubmissionId String?            @unique
  sourceType           EvidenceSourceType
  submittedAt          DateTime           @default(now())
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  studentProfile     StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competency         Competency          @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  homeworkSubmission HomeworkSubmission? @relation(fields: [homeworkSubmissionId], references: [id], onDelete: SetNull)
  assessments        RubricAssessment[]

  @@map("assessment_evidences")
}

model RubricAssessment {
  id           String   @id @default(uuid())
  rubricId     String
  evidenceId   String
  evaluatorId  String // User ID of evaluator
  overallScore Float?
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rubric    Rubric                  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  evidence  AssessmentEvidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evaluator User                    @relation(fields: [evaluatorId], references: [id])
  ratings   RubricCriterionRating[]

  @@map("rubric_assessments")
}

model RubricCriterionRating {
  id            String   @id @default(uuid())
  assessmentId  String
  criterionId   String
  selectedLevel Int
  comments      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessment RubricAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion  RubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, criterionId])
  @@map("rubric_criterion_ratings")
}

model CompetencyMastery {
  studentProfileId String
  competencyId     String
  masteryScore     Float
  confidence       Float
  status           MasteryStatus @default(NOT_STARTED)
  updatedAt        DateTime      @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  competency     Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, competencyId])
  @@map("competency_masteries")
}

enum MasteryStatus {
  NOT_STARTED
  INTRODUCED
  DEVELOPING
  NEAR_MASTERY
  MASTERED
}

model MasteryStatusChange {
  id               String        @id @default(uuid())
  studentProfileId String
  competencyId     String
  fromStatus       MasteryStatus
  toStatus         MasteryStatus
  masteryScore     Float
  confidence       Float
  reason           String?
  evidenceId       String? // AssessmentEvidence.id (scalar ref)
  changedById      String? // User.id (scalar ref — avoids User churn)
  createdAt        DateTime      @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competency     Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, competencyId, createdAt])
  @@map("mastery_status_changes")
}

model AuthSession {
  id                       String    @id @default(uuid())
  userId                   String
  refreshTokenHash         String    @unique
  // The hash rotated away on the most recent refresh, kept only long enough to
  // recognise a benign retry (network flake, app resumed mid-refresh) and tell
  // it apart from genuine token theft. Not unique: a replayed hash may briefly
  // coexist across rows, and colliding here would 500 rather than authenticate.
  previousRefreshTokenHash String?
  rotatedAt                DateTime?
  userAgent                String?
  ipAddress                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  expiresAt                DateTime
  revokedAt                DateTime?
  revokedReason            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([previousRefreshTokenHash])
  @@map("auth_sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  event       String
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

/// Assessment-bank taxonomy: tags Assessment and Question rows only.
///
/// NOT the same concept as `LearningSubject`, despite the name — there is no relation between the
/// two and no code path converts one to the other. `LearningSubject` is the catalogue taxonomy
/// (Course, LearningPath, ClassSection); this one exists purely to categorise the question bank.
/// Renaming this to `AssessmentSubject` is the eventual fix; until then, check which of the two you
/// mean before adding a relation to either.
model Subject {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]
  questions   Question[]

  @@map("subjects")
}

/// Academic level master — the top of the Class -> Program -> Course taxonomy.
///
/// Absorbs the former `Level` model, whose rows were always grade levels
/// (K, G1, G3, G5, G10, G11) but which was wired only to
/// Assessment/Question/PlacementRecommendation. Merging it here removed one of
/// three competing level concepts. `Course.gradeBand` deliberately survives —
/// see the comment on that field.
model Class {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  slug        String        @unique
  description String?
  sortOrder   Int           @default(0)
  status      CatalogStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  programs                 Program[]
  studentProfiles          StudentProfile[]
  assessments              Assessment[]
  questions                Question[]
  placementRecommendations PlacementRecommendation[]

  @@map("classes")
}

model AssessmentType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]

  @@map("assessment_types")
}

model Assessment {
  id                       String    @id @default(uuid())
  assessmentTypeId         String
  subjectId                String
  classId                  String
  termId                   String?
  weekNumber               Int?
  title                    String
  description              String?
  totalMarks               Int       @default(0)
  estimatedDurationMinutes Int       @default(0)
  status                   String    @default("draft") // draft, published, archived
  countsTowardGrade        Boolean   @default(true)
  maxAttempts              Int? // null = unlimited (matches today's real unconditional behavior)
  publishedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  deletedById              String?

  assessmentType AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  subject        Subject        @relation(fields: [subjectId], references: [id])
  class          Class          @relation(fields: [classId], references: [id])
  term           Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)

  sections    AssessmentSection[]
  questions   AssessmentQuestion[]
  assignments AssessmentAssignment[]
  moduleItems ModuleItem[]

  @@map("assessments")
}

model AssessmentSection {
  id           String   @id @default(uuid())
  assessmentId String
  title        String
  sortOrder    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  AssessmentQuestion[]

  @@map("assessment_sections")
}

model AssessmentQuestion {
  id             String   @id @default(uuid())
  assessmentId   String
  sectionId      String
  questionId     String
  questionNumber Int
  marksAvailable Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section    AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

model Question {
  id            String      @id @default(uuid())
  subjectId     String
  classId       String
  questionType  String // mcq, short_answer, numeric
  prompt        String
  correctAnswer String?
  difficulty    String      @default("medium") // easy, medium, hard
  status        String      @default("active") // active, archived
  widgetType    WidgetType? @default(STANDARD_MCQ)
  widgetConfig  Json?
  explanation   String?
  hints         String[]
  isGraded      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  deletedById   String?

  subject     Subject              @relation(fields: [subjectId], references: [id])
  class       Class                @relation(fields: [classId], references: [id])
  options     QuestionOption[]
  assessments AssessmentQuestion[]
  responses   StudentResponse[]
  card        Card?

  @@map("questions")
}

model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  optionLabel String // A, B, C, D
  optionText  String
  isCorrect   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question  Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses StudentResponse[]

  @@map("question_options")
}

model AssessmentAssignment {
  id               String   @id @default(uuid())
  assessmentId     String
  studentProfileId String
  lessonId         String?
  assignedByUserId String
  opensAt          DateTime
  dueAt            DateTime
  status           String   @default("assigned") // assigned, cancelled
  reminderCount    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assessment     Assessment          @relation(fields: [assessmentId], references: [id])
  studentProfile StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assignedByUser User                @relation("AssignedAssignments", fields: [assignedByUserId], references: [id])
  attempts       AssessmentAttempt[]
  lesson         Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@map("assessment_assignments")
}

model AssessmentAttempt {
  id                     String    @id @default(uuid())
  assessmentAssignmentId String
  studentProfileId       String
  attemptNumber          Int       @default(1)
  startedAt              DateTime  @default(now())
  submittedAt            DateTime?
  timeSpentSeconds       Int       @default(0)
  rawScore               Float?
  maxScore               Float?
  percentageScore        Float?
  resultStatus           String    @default("in_progress") // in_progress, completed, marked
  isLatest               Boolean   @default(true)
  isBest                 Boolean   @default(true)
  markedByUserId         String?
  teacherComment         String?
  parentComment          String?
  rawImportPayload       Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  assignment              AssessmentAssignment     @relation(fields: [assessmentAssignmentId], references: [id], onDelete: Cascade)
  studentProfile          StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  markedByUser            User?                    @relation("MarkedAttempts", fields: [markedByUserId], references: [id], onDelete: SetNull)
  responses               StudentResponse[]
  placementRecommendation PlacementRecommendation?

  @@map("assessment_attempts")
}

model StudentResponse {
  id                  String   @id @default(uuid())
  assessmentAttemptId String
  questionId          String
  selectedOptionId    String?
  responseText        String?
  interactionState    Json?
  isCorrect           Boolean?
  marksAwarded        Float?
  marksAvailable      Float    @default(1)
  timeSpentSeconds    Int      @default(0)
  feedback            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attempt        AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  question       Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption?   @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([assessmentAttemptId, questionId])
  @@map("student_responses")
}

model Lead {
