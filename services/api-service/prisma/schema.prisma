}

model RubricCriterion {
  id          String   @id @default(uuid())
  rubricId    String
  title       String
  description String?
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rubric  Rubric                  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels  RubricLevel[]
  ratings RubricCriterionRating[]

  @@map("rubric_criteria")
}

model RubricLevel {
  id          String   @id @default(uuid())
  criterionId String
  level       Int // 0, 1, 2, 3, 4
  title       String // e.g. "Proficient"
  description String // e.g. "Can compare independently"
  score       Float // e.g. 3.0
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, level])
  @@map("rubric_levels")
}

model AssessmentEvidence {
  id                   String             @id @default(uuid())
  studentProfileId     String
  competencyId         String
  homeworkSubmissionId String?            @unique
  sourceType           EvidenceSourceType
  submittedAt          DateTime           @default(now())
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  studentProfile     StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competency         Competency          @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  homeworkSubmission HomeworkSubmission? @relation(fields: [homeworkSubmissionId], references: [id], onDelete: SetNull)
  assessments        RubricAssessment[]

  @@map("assessment_evidences")
}

model RubricAssessment {
  id           String   @id @default(uuid())
  rubricId     String
  evidenceId   String
  evaluatorId  String // User ID of evaluator
  overallScore Float?
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rubric    Rubric                  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  evidence  AssessmentEvidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evaluator User                    @relation(fields: [evaluatorId], references: [id])
  ratings   RubricCriterionRating[]

  @@map("rubric_assessments")
}

model RubricCriterionRating {
  id            String   @id @default(uuid())
  assessmentId  String
  criterionId   String
  selectedLevel Int
  comments      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessment RubricAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterion  RubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, criterionId])
  @@map("rubric_criterion_ratings")
}

model CompetencyMastery {
  studentProfileId String
  competencyId     String
  masteryScore     Float
  confidence       Float
  status           MasteryStatus @default(NOT_STARTED)
  updatedAt        DateTime      @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  competency     Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, competencyId])
  @@map("competency_masteries")
}

enum MasteryStatus {
  NOT_STARTED
  INTRODUCED
  DEVELOPING
  NEAR_MASTERY
  MASTERED
}

model MasteryStatusChange {
  id               String        @id @default(uuid())
  studentProfileId String
  competencyId     String
  fromStatus       MasteryStatus
  toStatus         MasteryStatus
  masteryScore     Float
  confidence       Float
  reason           String?
  evidenceId       String? // AssessmentEvidence.id (scalar ref)
  changedById      String? // User.id (scalar ref — avoids User churn)
  createdAt        DateTime      @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competency     Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, competencyId, createdAt])
  @@map("mastery_status_changes")
}

enum GapSeverity {
  LOW
  MEDIUM
  HIGH
}

enum GapStatus {
  OPEN
  ADDRESSING
  RESOLVED
}

model LearningGap {
  id               String      @id @default(uuid())
  studentProfileId String
  competencyId     String
  severity         GapSeverity @default(MEDIUM)
  rootCause        String
  status           GapStatus   @default(OPEN)
  detectedFrom     String // "ASSESSMENT" | "LESSON" | "RUBRIC" | "OBSERVATION"
  evidenceCount    Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  resolvedAt       DateTime?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competency     Competency     @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  nextActions    NextAction[]

  @@index([studentProfileId, status])
  @@index([competencyId, status])
  @@map("learning_gaps")
}

enum NextActionType {
  REVIEW
  REASSESS
  INTERVENTION
  PRACTICE
}

enum NextActionStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model NextAction {
  id               String           @id @default(uuid())
  gapId            String?
  studentProfileId String
  competencyId     String
  actionType       NextActionType
  reason           String
  ownerUserId      String
  dueDate          DateTime
  reassessmentPlan String?
