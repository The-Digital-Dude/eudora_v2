# Base URL of api-service. EXPO_PUBLIC_ prefixed vars are inlined into the
# bundle, so nothing secret belongs here.
#
# Device-specific notes:
#   iOS simulator      -> http://localhost:5000
#   Android emulator   -> http://10.0.2.2:5000  (localhost is the emulator itself)
#   Physical device    -> http://<your-lan-ip>:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
