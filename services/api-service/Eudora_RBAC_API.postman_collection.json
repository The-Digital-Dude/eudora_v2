				{
					"name": "User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.access_token) {",
									"    pm.collectionVariables.set(\"token\", response.access_token);",
									"    console.log(\"Access token saved to collection variable 'token'\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
