enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TimetableSlotStatus {
  ACTIVE
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Timetable {
  id             String          @id @default(uuid())
